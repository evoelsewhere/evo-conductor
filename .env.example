CONDUCTOR_DATABASE_URL=sqlite:data/conductor.db?mode=rwc
# Examples:
# CONDUCTOR_DATABASE_URL=postgres://conductor:conductor@127.0.0.1:5432/conductor
# CONDUCTOR_DATABASE_URL=mysql://conductor:conductor@127.0.0.1:3306/conductor
# Connections the sqlx pool may open. SQLite allows one writer whatever the size.
# CONDUCTOR_DB_POOL_MAX_CONNECTIONS=10

CONDUCTOR_HOST=0.0.0.0
CONDUCTOR_PORT=4700
# When unset, the bind address saved in Project settings → Network is used.
CONDUCTOR_WEB_DIST=apps/web/dist
# CONDUCTOR_DATA_DIR=data
# Git storage uses the process SSH agent/credential helper, or a write-only
# HTTPS token stored under CONDUCTOR_DATA_DIR/git-storage (never in SQL).
# Realtime SSE capacity per Conductor process. These are the startup baseline;
# max connections, per-secret limit, and heartbeat can also be tuned in
# Project settings → Network (stored in the database).
CONDUCTOR_REALTIME_MAX_CONNECTIONS=10000
CONDUCTOR_REALTIME_MAX_CONNECTIONS_PER_SECRET=4
CONDUCTOR_REALTIME_MAX_CONCURRENT_HANDSHAKES=256
CONDUCTOR_REALTIME_BROADCAST_CAPACITY=512
CONDUCTOR_REALTIME_HEARTBEAT_SECONDS=20

# 100,000-connection profile: uncomment as a set, and comment out the five
# lines above. Extrapolated 10x from the soak-tested baseline, not itself
# soak-tested — see "Scaling beyond the 10,000 baseline" in
# docs/evoflux-integration.md. Requires Postgres and raised file-descriptor
# limits. Pool size covers in-flight query time, not connection count:
# ~5,000 revalidations/sec at sub-5ms lookups needs ~25 connections in flight.
# CONDUCTOR_DB_POOL_MAX_CONNECTIONS=100
# CONDUCTOR_REALTIME_MAX_CONNECTIONS=100000
# CONDUCTOR_REALTIME_MAX_CONNECTIONS_PER_SECRET=4
# CONDUCTOR_REALTIME_MAX_CONCURRENT_HANDSHAKES=2560
# CONDUCTOR_REALTIME_BROADCAST_CAPACITY=8192

# Frontend origin used after Microsoft/OIDC callback (setup public_url also works)
CONDUCTOR_PUBLIC_URL=http://127.0.0.1:5174
RUST_LOG=evo_conductor=info,tower_http=info
